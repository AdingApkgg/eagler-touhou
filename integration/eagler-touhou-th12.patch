diff --git a/launcher/scripts/prepare-th12-content.mjs b/launcher/scripts/prepare-th12-content.mjs
new file mode 100644
--- /dev/null
+++ b/launcher/scripts/prepare-th12-content.mjs
@@ -0,0 +1,14 @@
+import {existsSync} from 'node:fs';
+import path from 'node:path';
+import {spawnSync} from 'node:child_process';
+import {workspacePath} from '../lib/workspace-layout.mjs';
+const argument=(name,fallback)=>{
+  const inline=process.argv.find(value=>value.startsWith(name+'='));if(inline)return inline.slice(name.length+1);
+  const index=process.argv.indexOf(name);return index<0?fallback:process.argv[index+1];
+};
+const original=argument('--original',''),output=argument('--output','');
+if(!original||!output)throw Error('Usage: node scripts/prepare-th12-content.mjs --original=DIR --output=DIR [--assets=PREPARED_ASSETS]');
+const assets=argument('--assets',path.resolve(original,'site/assets'));
+if(!existsSync(path.join(assets,'menu-resources.json')))throw Error('TH12 currently requires locally prepared retail assets; run the title resource preparation first and supply --assets=DIR. Raw th12.dat import is not implemented.');
+const result=spawnSync(process.execPath,[workspacePath('th12','scripts/prepare-managed-content.mjs'),'--assets='+path.resolve(assets),'--output='+path.resolve(output)],{stdio:'inherit',windowsHide:true});
+if(result.error)throw result.error;process.exitCode=result.status??1;
